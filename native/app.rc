#include <windows.h>
#include "version.h"
1 ICON "assets/localstt.ico"
1 VERSIONINFO
FILEVERSION LOCALSTT_VERSION_MAJOR,LOCALSTT_VERSION_MINOR,LOCALSTT_VERSION_PATCH,0
PRODUCTVERSION LOCALSTT_VERSION_MAJOR,LOCALSTT_VERSION_MINOR,LOCALSTT_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "LocalSTT\0"
   VALUE "ProductName", "LocalSTT\0"
   VALUE "FileVersion", LOCALSTT_VERSION
   VALUE "ProductVersion", LOCALSTT_VERSION
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
