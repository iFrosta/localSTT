# Local runtime and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Python installation and virtual environments
Python312/
*.venv/
.venv/
venv/
env/

# Downloaded installers, and everything the diagnostics scripts write. These are
# records of one machine, so none of them belong in the repository.
downloads/
diagnostics/

# Local app state lives in %APPDATA%\LocalSTT, but keep backups out too
*.log
*.bak
*.bak-*
*.orig
history.jsonl
config.local.json

# Screenshots are generated; only the ones committed under docs/ are kept.
screenshots/

# Audio artifacts
*.wav
*.mp3
*.m4a
*.flac
*.ogg

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
