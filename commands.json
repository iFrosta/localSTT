{
  "version": 1,
  "commands": [
    {
      "name": "system.lock",
      "patterns": [
        "lock the computer",
        "lock the screen",
        "lock the pc"
      ],
      "type": "process",
      "command": "C:\\Windows\\System32\\rundll32.exe",
      "args": [
        "user32.dll,LockWorkStation"
      ]
    },
    {
      "name": "system.sleep",
      "patterns": [
        "put the computer to sleep",
        "sleep the computer",
        "go to sleep"
      ],
      "type": "process",
      "command": "C:\\Windows\\System32\\rundll32.exe",
      "args": [
        "powrprof.dll,SetSuspendState",
        "0,1,0"
      ]
    },
    {
      "name": "terminal.powershell",
      "patterns": [
        "open powershell",
        "launch powershell",
        "powershell"
      ],
      "type": "process",
      "command": "wt.exe",
      "args": [
        "-p",
        "Windows PowerShell"
      ],
      "requires": [
        "exe:wt.exe"
      ]
    },
    {
      "name": "terminal.wsl",
      "patterns": [
        "open wsl",
        "open ubuntu",
        "open a linux terminal"
      ],
      "type": "process",
      "command": "wt.exe",
      "args": [
        "-p",
        "Ubuntu"
      ],
      "requires": [
        "exe:wt.exe",
        "exe:wsl.exe"
      ]
    },
    {
      "name": "terminal.cmd",
      "patterns": [
        "open the command prompt",
        "open cmd",
        "command prompt"
      ],
      "type": "process",
      "command": "wt.exe",
      "args": [
        "-p",
        "Command Prompt"
      ],
      "requires": [
        "exe:wt.exe"
      ]
    },
    {
      "name": "terminal.open",
      "patterns": [
        "open a terminal",
        "open the terminal",
        "new terminal"
      ],
      "type": "process",
      "command": "wt.exe",
      "args": [],
      "requires": [
        "exe:wt.exe"
      ]
    },
    {
      "name": "terminal.fallback",
      "patterns": [
        "open a terminal",
        "open the terminal",
        "new terminal"
      ],
      "type": "process",
      "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoExit"
      ]
    },
    {
      "name": "app.vscode",
      "patterns": [
        "open vs code",
        "open visual studio code",
        "launch vs code"
      ],
      "type": "process",
      "command": "%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe",
      "args": []
    },
    {
      "name": "app.notepad",
      "patterns": [
        "open notepad",
        "new notepad",
        "launch notepad"
      ],
      "type": "process",
      "command": "notepad.exe",
      "args": []
    },
    {
      "name": "app.explorer",
      "patterns": [
        "open explorer",
        "open file explorer",
        "open the file manager"
      ],
      "type": "process",
      "command": "C:\\Windows\\explorer.exe",
      "args": []
    },
    {
      "name": "localstt.language.en",
      "patterns": [
        "switch to english",
        "set the language to english"
      ],
      "type": "localstt",
      "action": "language",
      "value": "en"
    },
    {
      "name": "localstt.language.ru",
      "patterns": [
        "switch to russian",
        "set the language to russian"
      ],
      "type": "localstt",
      "action": "language",
      "value": "ru"
    },
    {
      "name": "localstt.language.auto",
      "patterns": [
        "detect the language",
        "detect the language automatically"
      ],
      "type": "localstt",
      "action": "language",
      "value": "auto"
    },
    {
      "name": "localstt.repeat",
      "patterns": [
        "paste that again",
        "repeat the last text",
        "type that again"
      ],
      "type": "localstt",
      "action": "repeat"
    },
    {
      "name": "localstt.delivery.typewrite",
      "patterns": [
        "type the text",
        "switch to typing"
      ],
      "type": "localstt",
      "action": "delivery",
      "value": "typewrite"
    },
    {
      "name": "localstt.delivery.paste",
      "patterns": [
        "paste the text",
        "switch to pasting"
      ],
      "type": "localstt",
      "action": "delivery",
      "value": "paste"
    },
    {
      "name": "todo.create",
      "patterns": [
        "add todo *",
        "add a task *",
        "create a task *",
        "add a note *"
      ],
      "type": "microsoft_todo",
      "list": "Tasks"
    },
    {
      "name": "app.open",
      "patterns": [
        "open *",
        "launch *"
      ],
      "type": "app_launch"
    }
  ]
}
